# Run npm run setup:local to generate a private local .env without overwriting one.
# Node serves pages, authenticated API, and Socket.IO on one application origin.
PORT=4310
# Required exact application origin; HTTPS is mandatory in production.
# APP_ORIGIN=http://localhost:4310
# Required PostgreSQL connection string. Keep credentials server-only.
# DATABASE_URL=
# Required random secret (at least 32 characters); no production fallback exists.
# AUTH_SECRET=
# Optional public join origin; must be public HTTPS in production.
# PUBLIC_APP_URL=http://localhost:4310

# Docker Compose local development only; generated by setup:local.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=ruckus_development
# Integration tests require a separate local/CI ruckus_test database.
# TEST_DATABASE_URL=

# Set only when the Node service is behind a trusted loopback reverse proxy.
# Other proxy policies require an explicit reviewed configuration.
# TRUST_PROXY=loopback
# NODE_ENV=production

# Preserve existing explicit socket allowlists when a proxy/custom domain needs them.
# CLIENT_ORIGIN=https://your-ruckus-domain.example
# ALLOWED_ORIGINS=https://one-specific-approved-origin.example
# Optional client build metadata (public values, never secrets).
# VITE_PUBLIC_APP_URL=https://your-ruckus-domain.example
# VITE_REALTIME_URL=https://your-ruckus-domain.example
# Phase 1 does not support REALTIME_ONLY=true with unrelated-origin cookie auth.

# Transactional email: production requires smtp and explicit sender/host.
# Development defaults to private JSON files under ignored .local/mail (never logs links).
# Tests use memory capture; the isolated browser verification helper explicitly uses files.
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=Ruckus <no-reply@your-domain.example>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Production SMTP always requires TLS (implicit TLS or STARTTLS).
