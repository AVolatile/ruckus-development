{
  "name": "ruckus-development",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests *.ts *.js *.json docs/*.md README.md portfolio-assets/*.md",
    "assets": "python3 scripts/generate-assets.py && python3 scripts/generate-emails.py && .venv/bin/python scripts/refine-brand-assets.py",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "REALTIME_ONLY=true tsx watch server/index.ts",
    "build:client": "node scripts/validate-public-env.mjs && tsc --noEmit && vite build",
    "build:server": "tsc --noEmit -p tsconfig.server.json && tsc -p tsconfig.server.json",
    "start:server": "REALTIME_ONLY=true node dist-server/server/index.js",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:local": "node scripts/local-database.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test:integration": "node --env-file=.env.test --import tsx --test tests/integration/*.test.ts",
    "db:test:prepare": "node scripts/prepare-test-database.mjs",
    "db:migrate:production": "node dist-server/server/db/migrate.js",
    "audio:generate": "python3 scripts/generate-audio.py && prettier --write src/audio/assetCatalog.ts audio/assets.json",
    "audio:validate": "node scripts/validate-audio.mjs",
    "content:validate": "node --import tsx scripts/content.ts validate",
    "content:diff": "node --import tsx scripts/content.ts diff",
    "content:seed": "node --import tsx scripts/content.ts seed",
    "content:diff:production": "node dist-server/server/content-packs/cli.js diff",
    "content:seed:production": "node dist-server/server/content-packs/cli.js seed"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.8",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "better-auth": "1.7.8",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.4",
    "express": "^4.21.2",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "sharp": "0.35.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^6.3.6"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
